/* Reset de margens e paddings */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  line-height: 1.6;
}

header {
  background: #4CAF50;
  padding: 10px;
}

header nav ul {
  list-style: none;
  display: flex;
  justify-content: center;
}

header nav ul li {
  margin: 0 15px;
}

header nav ul li a {
  color: white;
  text-decoration: none;
  font-size: 18px;
}

main {
  padding: 20px;
}

h1, h2 {
  font-size: 24px;
  margin-bottom: 10px;
}

#endereco-form {
  display: flex;
  flex-direction: column;
  margin-bottom: 20px;
}

#endereco-form input {
  padding: 10px;
  margin: 5px 0;
  width: 100%;
}

#map {
  width: 100%;
  height: 400px;
}

footer {
  background: #333;
  color: white;
  text-align: center;
  padding: 10px;
}

@media (max-width: 768px) {
  header nav ul {
    flex-direction: column;
  }

  main {
    padding: 10px;
  }
}
